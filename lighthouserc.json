{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3101",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3101/",
        "http://localhost:3101/menu",
        "http://localhost:3101/cold-brew",
        "http://localhost:3101/outlets/c-scheme",
        "http://localhost:3101/story",
        "http://localhost:3101/book",
        "http://localhost:3101/events",
        "http://localhost:3101/events/coffee-rave"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [
              "warn",
              {
                "maxNumericValue": 174080
              }
            ],
            "total-byte-weight": [
              "warn",
              {
                "maxNumericValue": 1572864
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3101/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 174080
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}

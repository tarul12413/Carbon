{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3101",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3101/",
        "http://localhost:3101/menu",
        "http://localhost:3101/cold-brew",
        "http://localhost:3101/outlets/c-scheme",
        "http://localhost:3101/story"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 174080 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1572864 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
